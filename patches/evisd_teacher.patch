+def token_char_offsets_from_ids(tokenizer, token_ids: list[int]) -> tuple[str, list[tuple[int, int]]]:
+    """Decode generated IDs while retaining their original token boundaries."""
+    decode_kwargs = {
+        "skip_special_tokens": False,
+        "clean_up_tokenization_spaces": False,
+    }
+    response_text = tokenizer.decode(token_ids, **decode_kwargs)
+    pieces = tokenizer.batch_decode([[token_id] for token_id in token_ids], **decode_kwargs)
+    if "".join(pieces) == response_text:
+        boundaries = [0]
+        for piece in pieces:
+            boundaries.append(boundaries[-1] + len(piece))
+    else:
+        boundaries = [0]
+        for end in range(1, len(token_ids) + 1):
+            boundaries.append(len(tokenizer.decode(token_ids[:end], **decode_kwargs)))
+        if boundaries[-1] != len(response_text) or any(
+            right < left for left, right in zip(boundaries, boundaries[1:])
+        ):
+            raise ValueError("Tokenizer decode boundaries are not monotonic")
+    return response_text, list(zip(boundaries[:-1], boundaries[1:]))
+
