+        ]
+        if (
+            roundtrip_ids == [int(value) for value in token_ids]
+            and len(roundtrip_offsets) == len(token_ids)
+            and all(
+                0 <= start <= end <= len(response_text)
+                for start, end in roundtrip_offsets
+            )
+        ):
+            return response_text, roundtrip_offsets
+    except (KeyError, TypeError, ValueError, NotImplementedError):
+        pass
