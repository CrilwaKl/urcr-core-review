+def build_evisd_typed_action_masks(
+    batch: DataProto,
+    tokenizer,
+    response_mask: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return disjoint search, answer, and unchanged official action masks."""
+    responses = batch.batch["responses"]
+    _, response_length = responses.shape
+    search_masks = []
+    answer_masks = []
+    official_masks = []
+    for index in range(len(batch)):
+        valid_positions = torch.nonzero(
+            response_mask[index].bool(),
+            as_tuple=False,
+        ).flatten()
+        response_ids = responses[index, valid_positions].detach().cpu().tolist()
+        typed_masks = evisd_typed_action_masks_from_token_ids(tokenizer, response_ids)
+        padded = []
+        for values in typed_masks:
+            mask = torch.zeros(response_length, dtype=torch.float32)
+            if valid_positions.numel():
+                mask[valid_positions.detach().cpu()] = torch.tensor(
+                    values,
+                    dtype=torch.float32,
+                )
+            padded.append(mask)
+        search_masks.append(padded[0])
+        answer_masks.append(padded[1])
+        official_masks.append(padded[2])
+
+    target = {
+        "device": response_mask.device,
+        "dtype": response_mask.dtype,
+    }
+    return (
+        torch.stack(search_masks).to(**target),
+        torch.stack(answer_masks).to(**target),
+        torch.stack(official_masks).to(**target),
+    )
