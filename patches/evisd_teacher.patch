+def evisd_typed_action_masks_from_token_ids(
+    tokenizer,
+    response_ids: list[int],
+) -> tuple[list[int], list[int], list[int]]:
+    """Partition the official EviSD mask by the teacher's action context.
+
+    Search projection and the EviSD teacher both give the first complete search
+    action precedence over answer.  Malformed generations can contain both or
+    nest their spans, so independently parsed tag masks are not necessarily
+    disjoint.  Assigning the complete official action mask at the row level
+    preserves official EviSD while ensuring that search-conditioned tokens are
+    Q0 shadow only and answer correction is retained only for answer-conditioned
+    teacher rows.
+    """
+    response_text, offsets = token_char_offsets_from_ids(tokenizer, response_ids)
+    official = _span_mask_from_token_offsets(
+        offsets,
+        _find_action_spans(response_text, include_search=True, include_answer=True),
+        len(response_ids),
+    ).int()
+    zeros = torch.zeros_like(official)
+    action_type = _extract_action_type(response_text)
+    search = official if action_type == "search" else zeros
+    answer = official if action_type == "answer" else zeros
+    return search.tolist(), answer.tolist(), official.tolist()
 
 
