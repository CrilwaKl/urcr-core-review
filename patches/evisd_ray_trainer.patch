+    def _compute_urcr_v4_scores(
+        self,
+        items,
+        *,
+        micro_batch_size_per_gpu: int,
+        token_budget_per_gpu: int,
+    ) -> tuple[dict[str, float], dict[str, float]]:
+        """Send length-bucketed V4 views through staged four-rank RPCs."""
+        if not items:
+            return {}, {
+                "urcr_v4/scorer_item_count": 0.0,
+                "urcr_v4/scorer_unique_item_count": 0.0,
+                "urcr_v4/scorer_rpc_count": 0.0,
+                "urcr_v4/scorer_true_token_count": 0.0,
+                "urcr_v4/scorer_padded_token_count": 0.0,
+            }
+        if micro_batch_size_per_gpu <= 0 or token_budget_per_gpu <= 0:
+            raise ValueError("URCR-V4 scorer batch limits must be positive")
+
+        from verl.protocol import pad_dataproto_to_divisor, unpad_dataproto
+        from verl.trainer.ppo.urcr_v4_scorer import (
+            deduplicate_scorer_items,
+            expand_deduplicated_scores,
+            pack_scorer_items,
+            pad_teacher_forced_batch,
+            scorer_cost_summary,
+        )
+
+        deduplicated = deduplicate_scorer_items(items)
+        world_size = int(self.actor_rollout_wg.world_size)
+        staged = pack_scorer_items(
+            deduplicated.unique_items,
+            token_budget=int(token_budget_per_gpu) * world_size,
+            max_items=int(micro_batch_size_per_gpu) * world_size,
+            batch_divisor=world_size,
+        )
+        unique_scores: dict[str, float] = {}
+        allocated_before_max = 0
+        allocated_after_max = 0
+        peak_allocated_max = 0
+        for stage in staged:
+            padded = pad_teacher_forced_batch(
+                stage.items,
+                pad_token_id=int(self.tokenizer.pad_token_id),
+            )
+            score_batch = DataProto.from_dict(
+                tensors={
+                    "urcr_v4_input_ids": padded.input_ids,
+                    "urcr_v4_attention_mask": padded.attention_mask,
+                    "urcr_v4_position_ids": padded.position_ids,
+                    "urcr_v4_target_ids": padded.target_ids,
+                    "urcr_v4_target_mask": padded.target_mask,
+                    "urcr_v4_predictor_positions": padded.predictor_positions,
+                    "urcr_v4_blocked_key_mask": padded.blocked_key_mask,
+                },
+                non_tensors={
+                    "urcr_v4_request_id": list(padded.request_ids),
+                },
+                meta_info={
+                    "temperature": float(
+                        self.config.actor_rollout_ref.rollout.temperature
+                    ),
+                    "urcr_v4_scorer_micro_batch_size": int(
+                        micro_batch_size_per_gpu
+                    ),
+                },
+            )
+            score_batch, padding = pad_dataproto_to_divisor(
+                score_batch,
+                world_size,
+            )
+            scored = self.actor_rollout_wg.compute_urcr_v4_scores(score_batch)
+            scored = unpad_dataproto(scored, pad_size=padding)
+            if not scored.batch["urcr_v4_scorer_no_grad"].all().item():
+                raise RuntimeError("URCR-V4 scorer returned an autograd-attached row")
+            if not scored.batch["urcr_v4_backend_restored"].all().item():
+                raise RuntimeError("URCR-V4 scorer did not restore actor attention")
+            output_ids = [
+                str(value)
+                for value in scored.non_tensor_batch["urcr_v4_request_id"].tolist()
+            ]
+            output_scores = scored.batch[
+                "urcr_v4_mean_target_log_prob"
+            ].tolist()
+            if output_ids != list(padded.request_ids):
+                raise RuntimeError("URCR-V4 scorer changed request order")
+            allocated_before_max = max(
+                allocated_before_max,
+                int(scored.batch["urcr_v4_allocated_bytes_before"].max()),
+            )
+            allocated_after_max = max(
+                allocated_after_max,
+                int(scored.batch["urcr_v4_allocated_bytes_after"].max()),
+            )
+            peak_allocated_max = max(
+                peak_allocated_max,
+                int(scored.batch["urcr_v4_peak_allocated_bytes"].max()),
+            )
+            for request_id, value in zip(output_ids, output_scores):
+                if request_id in unique_scores:
+                    raise RuntimeError("URCR-V4 scorer returned a duplicate request")
+                unique_scores[request_id] = float(value)
+
+        if set(unique_scores) != {
+            item.request_id for item in deduplicated.unique_items
+        }:
+            raise RuntimeError("URCR-V4 scorer result set is incomplete")
+        costs = scorer_cost_summary(deduplicated.unique_items, staged)
+        metrics = {
+            "urcr_v4/scorer_item_count": float(len(items)),
+            "urcr_v4/scorer_unique_item_count": float(
+                len(deduplicated.unique_items)
+            ),
+            "urcr_v4/scorer_rpc_count": float(len(staged)),
+            "urcr_v4/scorer_true_token_count": float(costs["true_token_count"]),
+            "urcr_v4/scorer_padded_token_count": float(
+                costs["padded_token_count"]
+            ),
+            "urcr_v4/scorer_allocated_bytes_before_max": float(
+                allocated_before_max
+            ),
+            "urcr_v4/scorer_allocated_bytes_after_max": float(
+                allocated_after_max
+            ),
+            "urcr_v4/scorer_peak_allocated_bytes_max": float(
+                peak_allocated_max
+            ),
+        }
+        return expand_deduplicated_scores(deduplicated, unique_scores), metrics
+
+    def _select_urcr_v4_gradient_groups(
+        self,
+        batch: DataProto,
+        records,
+        *,
+        group_count: int,
+    ) -> tuple[str, ...]:
+        """Choose fixed mixed-reward groups with nonzero global policy gradient."""
+        import hashlib
+
+        from verl.trainer.ppo.urcr_v4_method import METHOD_REVISION
+
+        response_mask = batch.batch["response_mask"]
+        advantages = batch.batch["advantages"]
+        records_by_group = {}
+        for record in records:
+            if record.is_adjustment_copy:
+                continue
+            records_by_group.setdefault(record.rollout_group_id, []).append(record)
+        eligible = []
+        for group_id, group_records in records_by_group.items():
+            if any(
+                bool(
+                    (
+                        advantages[record.batch_row_index].abs()
+                        * response_mask[record.batch_row_index]
+                    ).any()
+                )
+                for record in group_records
+            ):
+                eligible.append(group_id)
+        if len(eligible) < int(group_count):
+            raise ValueError(
+                "V4 gradient calibration has only "
+                f"{len(eligible)} nonzero-global groups, requires {group_count}"
+            )
+        return tuple(
+            sorted(
+                eligible,
+                key=lambda group_id: hashlib.sha256(
+                    f"{METHOD_REVISION}|gradient-groups|{group_id}".encode()
+                ).digest(),
+            )[: int(group_count)]
+        )
+
+    def _build_urcr_v4_gradient_subbatch(
+        self,
+        batch: DataProto,
+        records,
+        *,
+        group_ids,
+    ) -> tuple[DataProto, dict]:
+        """Pack complete selected trajectories into one real actor minibatch."""
+        from verl.trainer.ppo.urcr_v4_pipeline import (
+            interleaved_gradient_batch_layout,
+        )
+
+        selected_groups = set(map(str, group_ids))
+        selected_records = [
+            record
+            for record in records
+            if not record.is_adjustment_copy
+            and record.rollout_group_id in selected_groups
+        ]
+        selected_indices = sorted(
+            {int(record.batch_row_index) for record in selected_records}
+        )
+        trajectory_ids = sorted(
+            {record.trajectory_id for record in selected_records}
+        )
+        observed_groups = {record.rollout_group_id for record in selected_records}
+        if observed_groups != selected_groups:
+            raise ValueError("V4 gradient subbatch lost a selected question group")
+        expected_trajectories = len(selected_groups) * int(self.config.env.rollout.n)
+        if len(trajectory_ids) != expected_trajectories:
+            raise ValueError("V4 gradient subbatch does not contain complete rollout groups")
+        original_mask = batch.batch["urcr_v4_original_row_mask"].bool()
+        if not all(bool(original_mask[index]) for index in selected_indices):
+            raise ValueError("V4 gradient subbatch selected a non-population row")
+
+        target_rows = int(
+            self.config.actor_rollout_ref.actor.ppo_mini_batch_size
+        )
+        micro_batch_size = int(
+            self.config.actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu
+        )
+        world_size = int(self.actor_rollout_wg.world_size)
+        if target_rows % (world_size * micro_batch_size):
+            raise ValueError("V4 gradient actor minibatch does not divide across ranks")
+        layout, keep = interleaved_gradient_batch_layout(
+            selected_indices,
+            target_row_count=target_rows,
+            micro_batch_size=micro_batch_size,
+        )
+        output = batch.select_idxs(np.asarray(layout, dtype=np.int64))
+        keep_mask = torch.tensor(
+            keep,
+            dtype=torch.bool,
+            device=output.batch["urcr_v4_original_row_mask"].device,
+        )
+        output.batch["urcr_v4_original_row_mask"] = keep_mask
+        padding = ~keep_mask
+        for key in ("urcr_v4_span_masks", "urcr_v4_span_coefficients"):
+            output.batch[key] = output.batch[key].clone()
+            output.batch[key][padding] = 0
+        output.batch["urcr_v4_span_channels"] = output.batch[
+            "urcr_v4_span_channels"
+        ].clone()
+        output.batch["urcr_v4_span_channels"][padding] = -1
+        spec = dict(output.meta_info["urcr_v4_local_objective"])
+        spec.update(
+            {
+                "total_sampling_row_count": len(selected_indices),
+                "original_trajectory_count": len(trajectory_ids),
+                "gradient_uses_unscaled_local": True,
+            }
+        )
+        output.meta_info["urcr_v4_local_objective"] = spec
+        output.meta_info["multi_turn"] = bool(
+            self.config.actor_rollout_ref.rollout.multi_turn.enable
+        )
+        output.meta_info["temperature"] = float(
+            self.config.actor_rollout_ref.rollout.temperature
+        )
+        return output, {
+            "group_ids": sorted(selected_groups),
+            "group_count": len(selected_groups),
+            "trajectory_count": len(trajectory_ids),
+            "turn_row_count": len(selected_indices),
+            "padded_actor_row_count": target_rows - len(selected_indices),
+            "actor_minibatch_row_count": target_rows,
+            "micro_batch_size_per_gpu": micro_batch_size,
+            "world_size": world_size,
+        }
+
+    def _load_urcr_v4_pooled_method(self, v4_cfg, *, lambda_max: float) -> tuple[dict, dict]:
+        """Load only the pooled empirical scales into the already frozen method."""
+        import hashlib
+        from pathlib import Path
+
+        pooled_path = Path(str(v4_cfg.get("pooled_calibration_artifact")))
+        pooled_bytes = pooled_path.read_bytes()
+        pooled = json.loads(pooled_bytes)
+        if pooled.get("artifact") != "urcr_v4_s150_pooled_calibration":
+            raise ValueError("unexpected URCR-V4 pooled calibration identity")
+        if not pooled.get("pass", False) or int(pooled.get("batch_count", 0)) != 10:
+            raise ValueError("URCR-V4 pooled calibration is incomplete")
+        if bool(pooled.get("resolved_method_frozen", True)):
+            raise ValueError("pooled calibration must remain pre-resolution evidence")
+        search = pooled["pooled"]["search"]["calibration"]
+        responsibility = pooled["pooled"]["responsibility"]["summary"]
+        method = {
+            "search_utility": {
+                "delta": float(search["delta"]),
+                "scale": float(search["scale"]),
+            },
+            "responsibility": {
+                "search": {
+                    "delta": float(responsibility["search_calibration"]["delta"]),
+                    "scale": float(responsibility["search_calibration"]["scale"]),
+                },
+                "answer": {
+                    "delta": float(responsibility["answer_calibration"]["delta"]),
+                    "scale": float(responsibility["answer_calibration"]["scale"]),
+                },
+            },
+            "local_loss": {
+                "lambda_max": float(lambda_max),
+                "warmup_steps": 30,
+            },
+        }
+        identity = {
+            "pooled_calibration_artifact": str(pooled_path.resolve()),
+            "pooled_calibration_sha256": hashlib.sha256(pooled_bytes).hexdigest(),
+            "pooled_calibration_batch_count": int(pooled["batch_count"]),
+            "pooled_calibration_question_count": int(pooled["question_count"]),
+            "pooled_calibration_trajectory_count": int(pooled["trajectory_count"]),
+        }
+        return method, identity
+
+    def _load_urcr_v4_resolved_method(self, v4_cfg) -> tuple[dict, dict]:
+        """Load the immutable post-calibration method used by every train step."""
+        from verl.trainer.ppo.urcr_v4_resolution import load_resolved_method
+
+        method, identity = load_resolved_method(
+            str(v4_cfg.get("resolved_method_artifact")),
+            expected_sha256=str(v4_cfg.get("resolved_method_sha256")),
+        )
+        scorer = identity["scorer"]
+        scorer_cfg = v4_cfg.get("scorer", {})
+        expected = {
+            "micro_batch_size_per_gpu": int(
+                scorer_cfg.get("micro_batch_size_per_gpu", 32)
+            ),
+            "token_budget_per_gpu": int(
+                scorer_cfg.get("token_budget_per_gpu", 262144)
+            ),
+            "max_total_tokens": int(scorer_cfg.get("max_total_tokens", 8192)),
+        }
+        for key, value in expected.items():
+            if int(scorer[key]) != value:
+                raise ValueError(f"URCR-V4 scorer contract changed: {key}")
+        return method, identity
+
+    def _write_urcr_v4_turn_components(
+        self,
+        diagnostics: dict,
+        v4_cfg,
+        method_identity: dict,
+    ) -> str:
+        """Persist compact metadata-free credit rows after the actor update."""
+        from dataclasses import asdict
+        from datetime import datetime
+        import hashlib
+        from pathlib import Path
+        from zoneinfo import ZoneInfo
+
+        from verl.trainer.ppo.urcr_v4_method import (
+            METHOD_REVISION,
+            require_no_online_evidence_metadata,
+        )
+
+        output_dir = Path(str(v4_cfg.get("turn_component_dir")))
+        if not str(v4_cfg.get("run_id") or ""):
+            raise ValueError("URCR-V4 training requires a run_id")
+        full_steps = {int(value) for value in v4_cfg.get("full_component_steps", [])}
+        sample_count = int(v4_cfg.get("sampled_turns_per_step", 8))
+        if sample_count <= 0:
+            raise ValueError("URCR-V4 sampled_turns_per_step must be positive")
+
+        records = [
+            record
+            for record in diagnostics["records"]
+            if not record.is_adjustment_copy
+        ]
+        credit_by_index = {
+            int(row.batch_row_index): row for row in diagnostics["assembly"].rows
+        }
+        full = int(self.global_steps) in full_steps
+        selected = records
+        if not full:
+            selected = sorted(
+                records,
+                key=lambda record: hashlib.sha256(
+                    (
+                        f"{METHOD_REVISION}|turn-log|{v4_cfg.get('run_id')}|"
+                        f"{self.global_steps}|{record.turn_id}"
+                    ).encode()
+                ).digest(),
+            )[:sample_count]
+        responsibility_reasons = diagnostics["responsibility_zero_reasons_by_turn"]
+        rows = []
+        for record in selected:
+            credit = credit_by_index[record.batch_row_index]
+            row = {
+                **asdict(credit),
+                "question_id": record.question_id,
+                "rollout_group_id": record.rollout_group_id,
+                "rollout_index": record.rollout_index,
+                "turn_index": record.turn_index,
+                "data_source": record.data_source,
+                "valid_action": record.valid_action,
+                "observation_consumable": record.observation_consumable,
+                "terminal_binary_em": record.terminal_binary_em,
+                "action_target_positions": list(record.action_target_positions),
+                "action_content_positions": list(record.action_content_positions),
+                "action_boundary_positions": list(record.action_boundary_positions),
+                "think_content_positions": list(record.think_content_positions),
+                "responsibility_zero_reason": responsibility_reasons.get(
+                    record.turn_id
+                ),
+            }
+            require_no_online_evidence_metadata(row)
+            rows.append(row)
+        payload = {
+            "schema_version": 1,
+            "artifact": "urcr_v4_turn_components",
+            "method_revision": METHOD_REVISION,
+            "resolved_method_sha256": method_identity["resolved_method_sha256"],
+            "run_id": str(v4_cfg.get("run_id")),
+            "global_step": int(self.global_steps),
+            "created_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(
+                timespec="seconds"
+            ),
+            "full_population": full,
+            "original_turn_count": len(records),
+            "saved_turn_count": len(rows),
+            "rows": rows,
+        }
+        require_no_online_evidence_metadata(payload)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        if full:
+            output = output_dir / f"step_{self.global_steps:05d}.json"
+            if output.exists():
+                raise FileExistsError(f"refusing to overwrite V4 components: {output}")
+            temporary = output.with_suffix(output.suffix + ".writing")
+            try:
+                temporary.write_text(
+                    json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n",
+                    encoding="utf-8",
+                )
+                os.replace(temporary, output)
+            finally:
+                temporary.unlink(missing_ok=True)
+        else:
+            output = output_dir / "turn_samples.jsonl"
+            with output.open("a", encoding="utf-8") as stream:
+                stream.write(
+                    json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n"
+                )
+                stream.flush()
+                os.fsync(stream.fileno())
+        return str(output)
+
+    def _run_urcr_v4_gradient_calibration(
+        self,
+        batch: DataProto,
+        v4_cfg,
+        *,
+        timing_raw: dict[str, float],
+        base_shadow: bool,
+    ) -> None:
+        """Measure raw local/global actor gradients without an optimizer update."""
+        from datetime import datetime
+        import hashlib
+        from pathlib import Path
+        from zoneinfo import ZoneInfo
+
+        from verl.trainer.ppo.urcr_v4_method import (
+            METHOD_REVISION,
+            apply_base_shadow_gradient_ceiling,
+            calibrate_gradient_scale,
+        )
+
+        output = Path(str(v4_cfg.get("diagnostic_output")))
+        if output.exists():
+            raise FileExistsError(f"refusing to overwrite V4 gradient artifact: {output}")
+
+        s150_gradient_identity = None
+        candidate_lambda = 1.0
+        if base_shadow:
+            s150_path = Path(str(v4_cfg.get("gradient_calibration_artifact")))
+            s150_bytes = s150_path.read_bytes()
+            s150_gradient_identity = json.loads(s150_bytes)
+            if s150_gradient_identity.get("artifact") != (
+                "urcr_v4_s150_gradient_calibration"
+            ) or not s150_gradient_identity.get("pass", False):
+                raise ValueError("S150 gradient calibration is missing or failed")
+            candidate_lambda = float(s150_gradient_identity["lambda_max"])
+        method, pooled_identity = self._load_urcr_v4_pooled_method(
+            v4_cfg,
+            lambda_max=candidate_lambda,
+        )
+
+        requested_group_count = 4 if base_shadow else 8
+        pipeline_metrics, diagnostics = self._prepare_urcr_v4_local_batch(
+            batch,
+            v4_cfg,
+            method,
+            diagnostic_group_count=None if base_shadow else requested_group_count,
+        )
+        records = diagnostics["records"]
+        if base_shadow:
+            selected_groups = self._select_urcr_v4_gradient_groups(
+                batch,
+                records,
+                group_count=requested_group_count,
+            )
+            group_partitions = (selected_groups,)
+        else:
+            selected_groups = diagnostics["selected_group_ids"]
+            if selected_groups is None or len(selected_groups) != 8:
+                raise RuntimeError("S150 gradient calibration did not select eight groups")
+            group_partitions = (selected_groups[:4], selected_groups[4:])
+
+        subbatch_results = []
+        for subbatch_index, group_ids in enumerate(group_partitions, start=1):
+            gradient_batch, subbatch_identity = (
+                self._build_urcr_v4_gradient_subbatch(
+                    batch,
+                    records,
+                    group_ids=group_ids,
+                )
+            )
+            started = time.perf_counter()
+            gradient_output = (
+                self.actor_rollout_wg.compute_urcr_v4_gradient_stats(
+                    gradient_batch
+                )
+            )
+            wall_seconds = time.perf_counter() - started
+            gradient_metrics = reduce_metrics(
+                gradient_output.meta_info["metrics"]
+            )
+            global_norm = float(
+                gradient_metrics["urcr_v4_gradient/global_l2"]
+            )
+            local_norm = float(
+                gradient_metrics["urcr_v4_gradient/local_l2"]
+            )
+            nonfinite = float(
+                gradient_metrics["urcr_v4_gradient/global_nonfinite_count"]
+            ) + float(
+                gradient_metrics["urcr_v4_gradient/local_nonfinite_count"]
+            )
+            if (
+                not np.isfinite(global_norm)
+                or not np.isfinite(local_norm)
+                or global_norm <= 0
+                or local_norm <= 0
+                or nonfinite != 0
+            ):
+                raise RuntimeError(
+                    f"invalid V4 gradient subbatch {subbatch_index}: "
+                    f"global={global_norm}, local={local_norm}, nonfinite={nonfinite}"
+                )
+            subbatch_results.append(
+                {
+                    "subbatch_index": subbatch_index,
+                    **subbatch_identity,
+                    "gradient": gradient_metrics,
+                    "driver_wall_seconds": wall_seconds,
+                }
+            )
+
+        if base_shadow:
+            gradient = subbatch_results[0]["gradient"]
+            final_lambda, full_strength_ratio = (
+                apply_base_shadow_gradient_ceiling(
+                    lambda_max=candidate_lambda,
+                    global_gradient_norm=float(
+                        gradient["urcr_v4_gradient/global_l2"]
+                    ),
+                    local_gradient_norm=float(
+                        gradient["urcr_v4_gradient/local_l2"]
+                    ),
+                )
+            )
+            lambda_0 = None
+            global_over_local = [
+                float(gradient["urcr_v4_gradient/global_over_local"])
+            ]
+        else:
+            frozen = calibrate_gradient_scale(
+                global_gradient_norms=[
+                    float(row["gradient"]["urcr_v4_gradient/global_l2"])
+                    for row in subbatch_results
+                ],
+                local_gradient_norms=[
+                    float(row["gradient"]["urcr_v4_gradient/local_l2"])
+                    for row in subbatch_results
+                ],
+            )
+            lambda_0 = frozen.lambda_0
+            final_lambda = frozen.lambda_max
+            global_over_local = list(frozen.global_over_local)
+            full_strength_ratio = max(
+                final_lambda / value for value in frozen.global_over_local
+            )
+
+        source_model = str(self.config.actor_rollout_ref.model.path)
+        model_manifest = Path(source_model) / "export_manifest.json"
+        model_identity = {
+            "path": source_model,
+            "export_manifest": (
+                str(model_manifest.resolve()) if model_manifest.is_file() else None
+            ),
+            "export_manifest_sha256": (
+                hashlib.sha256(model_manifest.read_bytes()).hexdigest()
+                if model_manifest.is_file()
+                else None
+            ),
+        }
+        result = {
+            "schema_version": 1,
+            "artifact": (
+                "urcr_v4_base_shadow_gradient_calibration"
+                if base_shadow
+                else "urcr_v4_s150_gradient_calibration"
+            ),
+            "method_revision": METHOD_REVISION,
+            "created_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(
+                timespec="seconds"
+            ),
+            "model": model_identity,
+            **pooled_identity,
+            "gradient_subbatches": subbatch_results,
+            "global_over_local": global_over_local,
+            "lambda_0": lambda_0,
+            "lambda_max_before_base_shadow": (
+                candidate_lambda if base_shadow else final_lambda
+            ),
+            "lambda_max": final_lambda,
+            "full_strength_local_over_global_max": full_strength_ratio,
+            "gradient_objectives": {
+                "global": "unscaled_grpo_policy_loss",
+                "local": "unscaled_sum_of_four_v4_channels",
+                "warmup_applied": False,
+                "optimizer_update_executed": False,
+            },
+            "base_shadow_lowered_lambda": bool(
+                base_shadow and final_lambda < candidate_lambda
+            ),
+            "coverage_metrics": pipeline_metrics,
+            "cost": {
+                "rollout_seconds": float(timing_raw.get("gen", 0.0)),
+                "reward_seconds": float(timing_raw.get("reward", 0.0)),
+                "old_log_prob_seconds": float(
+                    timing_raw.get("old_log_prob", 0.0)
+                ),
+                "optimizer_update_executed": False,
+            },
+            "pass": True,
+            "status": "pass",
+        }
+        if base_shadow and s150_gradient_identity is not None:
+            s150_path = Path(str(v4_cfg.get("gradient_calibration_artifact")))
+            result["s150_gradient_calibration_artifact"] = str(
+                s150_path.resolve()
+            )
+            result["s150_gradient_calibration_sha256"] = hashlib.sha256(
+                s150_path.read_bytes()
+            ).hexdigest()
+        output.parent.mkdir(parents=True, exist_ok=True)
+        temporary = output.with_suffix(output.suffix + ".writing")
+        try:
+            temporary.write_text(
+                json.dumps(result, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+            os.replace(temporary, output)
+        finally:
+            temporary.unlink(missing_ok=True)
+        print(
+            json.dumps(
+                {
+                    "artifact": result["artifact"],
+                    "output": str(output),
+                    "global_over_local": global_over_local,
+                    "lambda_0": lambda_0,
+                    "lambda_max": final_lambda,
+                    "full_strength_local_over_global_max": full_strength_ratio,
+                    "optimizer_update_executed": False,
+                    "status": "pass",
+                },
+                indent=2,
+                sort_keys=True,
+            )
