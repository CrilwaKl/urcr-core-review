+def resolve_phase_stop_step(
+    *,
+    total_training_steps: int,
+    current_global_step: int,
+    stop_after_steps: int | None,
+) -> int:
+    """Resolve a process boundary without changing the optimizer horizon."""
+    if stop_after_steps is None:
+        return int(total_training_steps)
+    stop_step = int(stop_after_steps)
+    if not 0 < stop_step <= int(total_training_steps):
+        raise ValueError(
+            "trainer.stop_after_steps must be in (0, total_training_steps], got "
+            f"{stop_step} with total_training_steps={total_training_steps}"
+        )
+    if stop_step <= int(current_global_step):
+        raise ValueError(
+            "trainer.stop_after_steps must be greater than the resumed global step, got "
+            f"{stop_step} <= {current_global_step}"
+        )
+    return stop_step
+
+
+def requires_urcr_responsibility(urcr_config) -> bool:
+    """Return whether responsibility affects the selected or requested audit path."""
+    if urcr_config.uses_v2_fixed_support_reward:
+        # g2_full still needs the frozen scorer's chunk-level LOO values even
+        # though its scalar rho is fixed to one.
+        return bool(
+            urcr_config.compute_shadow_modes
+            or urcr_config.method in {"g2_full", "g2_shuffled", "g2_real"}
+        )
+    return bool(
+        urcr_config.compute_shadow_modes
+        or urcr_config.method in {"g2_shuffled", "g2_real"}
+    )
