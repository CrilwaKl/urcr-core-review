+    def _run_urcr_v4_scorer_smoke(self, v4_cfg) -> None:
+        """Exercise the real four-rank actor scorer without rollout or update."""
+        from datetime import datetime
+        from pathlib import Path
+        from zoneinfo import ZoneInfo
+
+        from verl.trainer.ppo.urcr_v4_scorer import build_teacher_forced_item
+
+        scorer_cfg = v4_cfg.get("scorer", {})
+        output = Path(str(v4_cfg.get("diagnostic_output")))
+        if output.exists():
+            raise FileExistsError(f"refusing to overwrite V4 scorer smoke: {output}")
+        sizes = sorted(
+            {
+                int(value)
+                for value in scorer_cfg.get(
+                    "smoke_micro_batch_sizes_per_gpu", [8, 16, 32]
+                )
+            }
+        )
+        if not sizes or sizes[0] <= 0:
+            raise ValueError("V4 scorer smoke microbatch sizes must be positive")
+        if int(self.actor_rollout_wg.world_size) != 4:
+            raise ValueError("V4 scorer smoke requires the approved four-GPU worker")
+        item_count = 4 * max(sizes)
+        max_total_tokens = int(scorer_cfg.get("max_total_tokens", 8192))
+        token_budget_per_gpu = int(
+            scorer_cfg.get("token_budget_per_gpu", 262144)
+        )
+        target_ids = tuple(
+            int(value)
+            for value in self.tokenizer.encode("Paris", add_special_tokens=False)
+        )
+        if not target_ids:
+            raise ValueError("V4 scorer smoke target tokenized to empty")
+        items = []
+        for index in range(item_count):
+            chat = self.tokenizer.apply_chat_template(
+                [
+                    {
+                        "role": "system",
+                        "content": "You are a helpful and harmless assistant.",
+                    },
+                    {
+                        "role": "user",
+                        "content": (
+                            f"Scorer integration case {index}: identify the capital "
+                            "of France from the visible evidence."
+                        ),
+                    },
+                ],
+                tokenize=True,
+                add_generation_prompt=True,
+            )
+            think_open = self.tokenizer.encode(
+                "<think>\n", add_special_tokens=False
+            )
+            think_text = " ".join(
+                [f"Visible evidence item {index} supports Paris."]
+                * (2 + index % 7)
+            )
+            think_ids = self.tokenizer.encode(
+                think_text,
+                add_special_tokens=False,
+            )
+            answer_prefix = self.tokenizer.encode(
+                "\n</think>\n<answer>\n",
+                add_special_tokens=False,
+            )
+            context = (*chat, *think_open, *think_ids, *answer_prefix)
+            think_start = len(chat) + len(think_open)
+            blocked = (
+                tuple(range(think_start, think_start + len(think_ids)))
+                if index % 2
+                else ()
+            )
+            items.append(
+                build_teacher_forced_item(
+                    request_id=f"scorer-smoke:{index}",
+                    view="whole_mask" if blocked else "plain",
+                    actor_snapshot_id="urcr-v4-scorer-smoke",
+                    context_ids=context,
+                    target_prefix_ids=(),
+                    target_content_ids=target_ids,
+                    blocked_key_positions=blocked,
+                    max_total_tokens=max_total_tokens,
+                )
+            )
+
+        runs = {}
+        score_vectors = {}
+        for size in sizes:
+            started = time.perf_counter()
+            scores, score_metrics = self._compute_urcr_v4_scores(
+                items,
+                micro_batch_size_per_gpu=size,
+                token_budget_per_gpu=token_budget_per_gpu,
+            )
+            values = np.asarray(
+                [scores[item.request_id] for item in items], dtype=np.float64
+            )
+            if not np.isfinite(values).all():
+                raise RuntimeError("V4 scorer smoke returned nonfinite scores")
+            score_vectors[size] = values
+            runs[str(size)] = {
+                "wall_seconds": time.perf_counter() - started,
+                "score_mean": float(values.mean()),
+                "score_std": float(values.std()),
+                **score_metrics,
+            }
+
+        repeat_size = max(sizes)
+        repeated_scores, repeated_metrics = self._compute_urcr_v4_scores(
+            items,
+            micro_batch_size_per_gpu=repeat_size,
+            token_budget_per_gpu=token_budget_per_gpu,
+        )
+        repeated = np.asarray(
+            [repeated_scores[item.request_id] for item in items],
+            dtype=np.float64,
+        )
+        repeat_max_abs = float(
+            np.max(np.abs(repeated - score_vectors[repeat_size]))
+        )
+        reference_size = min(sizes)
+        for size in sizes:
+            difference = np.abs(score_vectors[size] - score_vectors[reference_size])
+            runs[str(size)]["vs_smallest_mean_abs"] = float(difference.mean())
+            runs[str(size)]["vs_smallest_max_abs"] = float(difference.max())
+
+        result = {
+            "schema_version": 1,
+            "artifact": "urcr_v4_four_gpu_fsdp_scorer_smoke",
+            "created_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(
+                timespec="seconds"
+            ),
+            "model": str(self.config.actor_rollout_ref.model.path),
+            "world_size": int(self.actor_rollout_wg.world_size),
+            "temperature": float(
+                self.config.actor_rollout_ref.rollout.temperature
+            ),
+            "item_count": item_count,
+            "sequence_length_min": min(item.sequence_length for item in items),
+            "sequence_length_max": max(item.sequence_length for item in items),
+            "micro_batch_sizes_per_gpu": sizes,
+            "repeat_micro_batch_size_per_gpu": repeat_size,
+            "repeat_max_abs_difference": repeat_max_abs,
+            "repeat_metrics": repeated_metrics,
+            "runs": runs,
+            "pass": repeat_max_abs <= 1e-7,
+        }
+        output.parent.mkdir(parents=True, exist_ok=True)
+        temporary = output.with_suffix(output.suffix + ".writing")
+        try:
+            temporary.write_text(
+                json.dumps(result, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+            os.replace(temporary, output)
+        finally:
+            temporary.unlink(missing_ok=True)
+        print(json.dumps(result, indent=2, sort_keys=True))
+        if not result["pass"]:
+            raise RuntimeError("URCR-V4 scorer smoke was not deterministic")
+
+    def _run_urcr_v4_pipeline_smoke_batch(self, batch: DataProto, v4_cfg) -> None:
+        """Run one small metadata-free rollout batch through V4 credit assembly."""
+        from collections import Counter
+        from datetime import datetime
+        from pathlib import Path
+        from zoneinfo import ZoneInfo
+
+        from verl.trainer.ppo.urcr_v4_controller import (
+            action_utilities,
+            build_responsibility_request_plan,
+            build_search_request_plan,
+            resolve_responsibilities,
+            resolve_search_utilities,
+        )
+        from verl.trainer.ppo.urcr_v4_data import build_v4_turn_records
+        from verl.trainer.ppo.urcr_v4_pipeline import (
+            assemble_local_credits,
+            local_credit_tensors,
+        )
+
+        started = time.perf_counter()
+        if "metadata" in batch.non_tensor_batch:
+            raise RuntimeError("URCR-V4 rollout batch retained dataset metadata")
+        scorer_cfg = v4_cfg.get("scorer", {})
+        micro_batch_size = int(
+            scorer_cfg.get("micro_batch_size_per_gpu", 32)
+        )
+        token_budget = int(scorer_cfg.get("token_budget_per_gpu", 262144))
+        max_total_tokens = int(scorer_cfg.get("max_total_tokens", 8192))
+        actor_snapshot_id = f"outer-step-{self.global_steps}-pre-update"
+        records = build_v4_turn_records(
+            batch=batch,
+            tokenizer=self.tokenizer,
+            global_step=self.global_steps,
+            expected_rollouts_per_group=int(self.config.env.rollout.n),
+        )
+        search_plan = build_search_request_plan(
+            records,
+            tokenizer=self.tokenizer,
+            actor_snapshot_id=actor_snapshot_id,
+            max_total_tokens=max_total_tokens,
+            max_anchors=int(v4_cfg.get("pipeline_smoke_search_anchors", 16)),
+        )
+        search_scores, search_score_metrics = self._compute_urcr_v4_scores(
+            search_plan.items,
+            micro_batch_size_per_gpu=micro_batch_size,
+            token_budget_per_gpu=token_budget,
+        )
+        search_utilities = resolve_search_utilities(
+            search_plan,
+            search_scores,
+            records,
+            delta=0.0,
+            scale=1.0,
+        )
+        utilities = action_utilities(records, search_utilities)
+        responsibility_plan = build_responsibility_request_plan(
+            records,
+            utilities,
+            actor_snapshot_id=actor_snapshot_id,
+            max_total_tokens=max_total_tokens,
+            max_search_anchors=int(
+                v4_cfg.get("pipeline_smoke_query_responsibility_anchors", 8)
+            ),
+            max_answer_anchors=int(
+                v4_cfg.get("pipeline_smoke_answer_responsibility_anchors", 8)
+            ),
+        )
+        responsibility_scores, responsibility_score_metrics = (
+            self._compute_urcr_v4_scores(
+                responsibility_plan.items,
+                micro_batch_size_per_gpu=micro_batch_size,
+                token_budget_per_gpu=token_budget,
+            )
+        )
+        responsibilities = resolve_responsibilities(
+            responsibility_plan,
+            responsibility_scores,
+            records,
+            utilities,
+            query_delta=0.0,
+            query_scale=1.0,
+            answer_delta=0.0,
+            answer_scale=1.0,
+            query_chunk_delta=0.0,
+            answer_chunk_delta=0.0,
+        )
+        assembly = assemble_local_credits(
+            records,
+            search_utilities=search_utilities,
+            responsibilities=responsibilities,
+        )
+        local_tensors = local_credit_tensors(
+            assembly,
+            response_mask=batch.batch["response_mask"],
+        )
+        coefficients = local_tensors["urcr_v4_span_coefficients"]
+        utility_values = np.asarray(list(utilities.values()), dtype=np.float64)
+        zero_reasons = Counter(
+            result.zero_reason or "nonzero"
+            for result in search_utilities.values()
+        )
+        output = Path(str(v4_cfg.get("diagnostic_output")))
+        result = {
+            "schema_version": 1,
+            "artifact": "urcr_v4_four_gpu_pipeline_smoke",
+            "created_at": datetime.now(ZoneInfo("Asia/Shanghai")).isoformat(
+                timespec="seconds"
+            ),
+            "model": str(self.config.actor_rollout_ref.model.path),
+            "global_step": int(self.global_steps),
+            "world_size": int(self.actor_rollout_wg.world_size),
+            "temperature": float(
+                self.config.actor_rollout_ref.rollout.temperature
+            ),
+            "train_questions": int(self.config.data.train_batch_size),
+            "rollouts_per_question": int(self.config.env.rollout.n),
+            "metadata_present": False,
+            "turn_count": len(records),
+            "original_trajectory_count": assembly.original_trajectory_count,
+            "valid_search_count": sum(
+                record.action_type == "search" and record.valid_action
+                for record in records
+                if not record.is_adjustment_copy
+            ),
+            "valid_answer_count": sum(
+                record.action_type == "answer" and record.valid_action
+                for record in records
+                if not record.is_adjustment_copy
+            ),
+            "boundary_only_action_count": sum(
+                record.valid_action
+                and bool(record.action_boundary_positions)
+                and not record.action_content_positions
+                for record in records
+                if not record.is_adjustment_copy
+            ),
+            "no_think_valid_action_count": sum(
+                record.valid_action and not record.think_chunks
+                for record in records
+                if not record.is_adjustment_copy
+            ),
+            "search_bundle_count": len(search_plan.bundles),
+            "search_item_count": len(search_plan.items),
+            "search_zero_reasons": dict(sorted(zero_reasons.items())),
+            "responsibility_bundle_count": len(responsibility_plan.bundles),
+            "responsibility_item_count": len(responsibility_plan.items),
+            "responsibility_zero_reasons": dict(
+                sorted(Counter(responsibility_plan.zero_reasons.values()).items())
+            ),
+            "action_utility_positive_count": int((utility_values > 0).sum()),
+            "action_utility_negative_count": int((utility_values < 0).sum()),
+            "action_utility_zero_count": int((utility_values == 0).sum()),
+            "local_nonzero_span_count": int((coefficients != 0).sum()),
+            "local_absolute_coefficient_sum": float(
+                coefficients.abs().sum().item()
+            ),
+            "search_scorer": search_score_metrics,
+            "responsibility_scorer": responsibility_score_metrics,
+            "provisional_scales": {
+                "diagnostic_only": True,
+                "utility_delta": 0.0,
+                "utility_scale": 1.0,
+                "responsibility_delta": 0.0,
+                "responsibility_scale": 1.0,
+                "used_for_optimizer_update": False,
+            },
+            "wall_seconds": time.perf_counter() - started,
+            "pass": True,
+        }
+        output.parent.mkdir(parents=True, exist_ok=True)
+        temporary = output.with_suffix(output.suffix + ".writing")
+        try:
+            temporary.write_text(
+                json.dumps(result, indent=2, sort_keys=True) + "\n",
+                encoding="utf-8",
+            )
+            os.replace(temporary, output)
+        finally:
+            temporary.unlink(missing_ok=True)
+        print(json.dumps(result, indent=2, sort_keys=True))
+
+    def _run_urcr_v4_calibration_batch(
+        self,
+        batch: DataProto,
+        v4_cfg,
+        *,
+        timing_raw: dict[str, float],
+        output_path=None,
+        calibration_identity: dict | None = None,
+    ) -> None:
+        """Calibrate V4 scales once from the frozen 128x8 S150 batch."""
+        from collections import Counter
+        from datetime import datetime
+        import hashlib
+        from pathlib import Path
+        from zoneinfo import ZoneInfo
+
+        from verl.trainer.ppo.urcr_v4_calibration import (
+            answer_residual_diagnostics,
+            calibrate_responsibility_scores,
+            calibrate_search_scores,
+        )
+        from verl.trainer.ppo.urcr_v4_controller import (
+            action_utilities,
+            build_calibration_responsibility_request_plan,
+            build_search_request_plan,
+        )
+        from verl.trainer.ppo.urcr_v4_data import build_v4_turn_records
+        from verl.trainer.ppo.urcr_v4_method import METHOD_REVISION
+
+        started = time.perf_counter()
+        if "metadata" in batch.non_tensor_batch:
+            raise RuntimeError("URCR-V4 calibration retained dataset metadata")
+        scorer_cfg = v4_cfg.get("scorer", {})
+        micro_batch_size = int(scorer_cfg.get("micro_batch_size_per_gpu", 32))
+        token_budget = int(scorer_cfg.get("token_budget_per_gpu", 262144))
+        max_total_tokens = int(scorer_cfg.get("max_total_tokens", 8192))
+        output = Path(
+            str(
+                output_path
+                if output_path is not None
+                else v4_cfg.get("diagnostic_output")
+            )
+        )
+        if output.exists():
+            raise FileExistsError(f"refusing to overwrite V4 calibration: {output}")
+
+        numeric_reference_path = Path(
+            str(v4_cfg.get("numeric_reference_artifact"))
+        )
+        if not numeric_reference_path.is_file():
+            raise FileNotFoundError(
+                f"missing V4 numeric reference: {numeric_reference_path}"
+            )
+        numeric_reference_bytes = numeric_reference_path.read_bytes()
+        numeric_reference = json.loads(numeric_reference_bytes)
+        if not numeric_reference.get("pass", False):
+            raise ValueError("V4 numeric reference did not pass")
+        if str(numeric_reference.get("model")) != str(
+            self.config.actor_rollout_ref.model.path
+        ):
+            raise ValueError("V4 numeric reference uses a different model")
+        if int(
+            numeric_reference.get("repeat_micro_batch_size_per_gpu", -1)
+        ) != micro_batch_size:
+            raise ValueError(
+                "V4 numeric reference does not match the configured microbatch"
+            )
+        repeat_difference = float(
+            numeric_reference.get("repeat_max_abs_difference", float("nan"))
+        )
+        if not np.isfinite(repeat_difference) or repeat_difference < 0:
+            raise ValueError("V4 numeric reference has an invalid repeat difference")
+        numeric_differences = [repeat_difference]
+
+        actor_snapshot_id = f"outer-step-{self.global_steps}-pre-update"
+        records = build_v4_turn_records(
+            batch=batch,
+            tokenizer=self.tokenizer,
+            global_step=self.global_steps,
+            expected_rollouts_per_group=int(self.config.env.rollout.n),
+        )
+        original_records = [record for record in records if not record.is_adjustment_copy]
+        original_trajectories = {record.trajectory_id for record in original_records}
+        original_groups = {record.rollout_group_id for record in original_records}
+
+        controller_started = time.perf_counter()
+        search_plan = build_search_request_plan(
+            records,
+            tokenizer=self.tokenizer,
+            actor_snapshot_id=actor_snapshot_id,
+            max_total_tokens=max_total_tokens,
+            max_anchors=int(v4_cfg.get("calibration_search_anchors", 256)),
+        )
+        search_controller_seconds = time.perf_counter() - controller_started
+        scorer_started = time.perf_counter()
+        search_scores, search_score_metrics = self._compute_urcr_v4_scores(
+            search_plan.items,
+            micro_batch_size_per_gpu=micro_batch_size,
+            token_budget_per_gpu=token_budget,
+        )
+        search_scorer_seconds = time.perf_counter() - scorer_started
+        frozen_search = calibrate_search_scores(
+            search_plan,
+            search_scores,
+            records,
+            numeric_absolute_differences=numeric_differences,
+        )
+
+        answer_diagnostics = answer_residual_diagnostics(records)
+        utilities = action_utilities(records, frozen_search.utilities)
+        controller_started = time.perf_counter()
+        responsibility_plan = build_calibration_responsibility_request_plan(
+            records,
+            utilities,
+            actor_snapshot_id=actor_snapshot_id,
+            max_total_tokens=max_total_tokens,
+            max_search_anchors=int(
+                v4_cfg.get("calibration_query_responsibility_anchors", 64)
+            ),
+            max_answer_anchors=int(
+                v4_cfg.get("calibration_answer_responsibility_anchors", 64)
+            ),
+        )
+        responsibility_controller_seconds = (
+            time.perf_counter() - controller_started
+        )
+        scorer_started = time.perf_counter()
+        responsibility_scores, responsibility_score_metrics = (
+            self._compute_urcr_v4_scores(
+                responsibility_plan.items,
+                micro_batch_size_per_gpu=micro_batch_size,
+                token_budget_per_gpu=token_budget,
+            )
+        )
+        responsibility_scorer_seconds = time.perf_counter() - scorer_started
+        frozen_responsibility = calibrate_responsibility_scores(
+            responsibility_plan,
+            responsibility_scores,
+            numeric_absolute_differences={
+                "search": numeric_differences,
+                "answer": numeric_differences,
+            },
+        )
+
+        limitations = []
+        if frozen_search.calibration.limited:
+            limitations.append("search_scale_has_fewer_than_8_active_excesses")
+        if frozen_responsibility.search.limited:
+            limitations.append("search_responsibility_uses_scale_fallback")
+        if frozen_responsibility.answer.limited:
+            limitations.append("answer_responsibility_uses_scale_fallback")
+        if (
+            answer_diagnostics["summary"]["nonzero_residual_group_count"] == 0
+        ):
