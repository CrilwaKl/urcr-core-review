+    @register(dispatch_mode=Dispatch.DP_COMPUTE_PROTO)
+    def compute_urcr_v4_scores(self, data: DataProto):
+        """Score a staged URCR-V4 teacher-forcing queue on the frozen actor."""
+        assert self._is_actor
+        if self.ulysses_sequence_parallel_size != 1:
+            raise ValueError("URCR-V4 scorer requires Ulysses sequence parallel size 1")
+        required = {
+            "urcr_v4_input_ids",
+            "urcr_v4_attention_mask",
+            "urcr_v4_position_ids",
+            "urcr_v4_target_ids",
+            "urcr_v4_target_mask",
+            "urcr_v4_predictor_positions",
+            "urcr_v4_blocked_key_mask",
+        }
+        missing = required - set(data.batch.keys())
+        if missing:
+            raise ValueError(f"URCR-V4 scorer tensors are incomplete: {sorted(missing)}")
+        if "temperature" not in data.meta_info:
+            raise ValueError("URCR-V4 scorer requires an explicit temperature")
+        if "urcr_v4_scorer_micro_batch_size" not in data.meta_info:
+            raise ValueError("URCR-V4 scorer requires an explicit microbatch size")
+        if self._is_offload_param:
+            load_fsdp_model_to_gpu(self.actor_module_fsdp)
+
+        from verl.trainer.ppo.urcr_responsibility import (
+            model_attention_backends_restored,
+            restore_model_attention_backends,
+            set_model_attention_backend,
+        )
+        from verl.trainer.ppo.urcr_v4_scorer import (
+            PaddedTeacherForcedBatch,
+            score_teacher_forced_microbatches,
+        )
+
+        data = data.to(get_torch_device().current_device())
+        model = self.actor_module_fsdp
+        was_training = model.training
+        backend_states = []
+        backend_restored = False
+        allocated_before = int(get_torch_device().memory_allocated())
+        try:
+            if any(parameter.grad is not None for parameter in model.parameters()):
+                raise RuntimeError("Actor gradients must be empty before V4 scoring")
+            backend_states = set_model_attention_backend(
+                model,
+                "sdpa",
+                extra_configs=(self.actor_model_config,),
+            )
+            model.eval()
+            request_ids = data.non_tensor_batch.get("urcr_v4_request_id")
+            if request_ids is None:
+                request_ids = [str(index) for index in range(len(data))]
+            if len(request_ids) != len(data):
+                raise ValueError("URCR-V4 scorer request IDs do not match its tensors")
+            padded = PaddedTeacherForcedBatch(
+                request_ids=tuple(str(value) for value in request_ids),
+                input_ids=data.batch["urcr_v4_input_ids"],
+                attention_mask=data.batch["urcr_v4_attention_mask"],
+                position_ids=data.batch["urcr_v4_position_ids"],
+                target_ids=data.batch["urcr_v4_target_ids"],
+                target_mask=data.batch["urcr_v4_target_mask"],
+                predictor_positions=data.batch["urcr_v4_predictor_positions"],
+                blocked_key_mask=data.batch["urcr_v4_blocked_key_mask"],
+            )
+            scored = score_teacher_forced_microbatches(
+                model,
+                padded,
+                micro_batch_size=int(
+                    data.meta_info["urcr_v4_scorer_micro_batch_size"]
+                ),
+                temperature=float(data.meta_info["temperature"]),
+            )
+            if scored.mean_target_log_probs.requires_grad:
+                raise RuntimeError("URCR-V4 scorer output is attached to autograd")
+            if any(parameter.grad is not None for parameter in model.parameters()):
+                raise RuntimeError("URCR-V4 scoring populated actor gradients")
+            restore_model_attention_backends(backend_states)
+            backend_restored = model_attention_backends_restored(backend_states)
+            model.train(was_training)
+            row_count = len(data)
+            allocated_after = int(get_torch_device().memory_allocated())
+            peak_allocated = int(get_torch_device().max_memory_allocated())
+            output = DataProto.from_dict(
+                tensors={
+                    "urcr_v4_mean_target_log_prob": scored.mean_target_log_probs,
+                    "urcr_v4_scorer_forward_microbatch_count": torch.full(
+                        (row_count,),
+                        scored.forward_microbatch_count,
+                        dtype=torch.long,
+                        device=get_torch_device().current_device(),
+                    ),
+                    "urcr_v4_scorer_no_grad": torch.ones(
+                        row_count,
+                        dtype=torch.bool,
+                        device=get_torch_device().current_device(),
+                    ),
+                    "urcr_v4_backend_restored": torch.full(
+                        (row_count,),
+                        backend_restored,
+                        dtype=torch.bool,
+                        device=get_torch_device().current_device(),
+                    ),
+                    "urcr_v4_allocated_bytes_before": torch.full(
+                        (row_count,),
+                        allocated_before,
+                        dtype=torch.long,
+                        device=get_torch_device().current_device(),
+                    ),
+                    "urcr_v4_allocated_bytes_after": torch.full(
+                        (row_count,),
+                        allocated_after,
+                        dtype=torch.long,
+                        device=get_torch_device().current_device(),
+                    ),
+                    "urcr_v4_peak_allocated_bytes": torch.full(
+                        (row_count,),
+                        peak_allocated,
+                        dtype=torch.long,
+                        device=get_torch_device().current_device(),
+                    ),
+                },
+                non_tensors={
+                    "urcr_v4_request_id": list(map(str, request_ids)),
+                },
+            ).to("cpu")
+        finally:
+            restore_model_attention_backends(backend_states)
+            model.train(was_training)
+            if self.world_size > 1 and fsdp_version(self.actor_module_fsdp) == 1:
+                for handle in self.actor_module_fsdp._all_handles:
+                    handle.reshard(True)
+            if self._is_offload_param:
+                offload_fsdp_model_to_cpu(self.actor_module_fsdp)
+                log_gpu_memory_usage(
+                    "After offload actor model during URCR-V4 scoring",
+                    logger=logger,
+                )
+        return output
+
+    @register(dispatch_mode=Dispatch.DP_COMPUTE_PROTO)
+    def compute_urcr_v4_gradient_stats(self, data: DataProto):
+        """Measure V4 global/local parameter gradients without optimizer state changes."""
+        assert self._is_actor
+        if self.ulysses_sequence_parallel_size != 1:
+            raise ValueError("URCR-V4 gradient calibration requires Ulysses size 1")
+        if self._is_offload_param:
+            load_fsdp_model_to_gpu(self.actor_module_fsdp)
+        try:
+            with self.ulysses_sharding_manager:
+                data = data.to(get_torch_device().current_device())
+                data = self.ulysses_sharding_manager.preprocess_data(data=data)
+                with Timer(name="urcr_v4_gradient_calibration", logger=None) as timer:
+                    metrics = self.actor.compute_urcr_v4_gradient_stats(data)
+                metrics["urcr_v4_gradient/wall_seconds"] = timer.last
+                metrics["urcr_v4_gradient/peak_memory_allocated_gib"] = (
+                    get_torch_device().max_memory_allocated() / (1024**3)
+                )
+                output = DataProto(meta_info={"metrics": metrics})
+                output = self.ulysses_sharding_manager.postprocess_data(data=output)
+                output = output.to("cpu")
+        finally:
+            self.actor.actor_optimizer.zero_grad(set_to_none=True)
+            if self.world_size > 1 and fsdp_version(self.actor_module_fsdp) == 1:
+                for handle in self.actor_module_fsdp._all_handles:
+                    handle.reshard(True)
+            if self._is_offload_param:
+                offload_fsdp_model_to_cpu(self.actor_module_fsdp)
+                log_gpu_memory_usage(
+                    "After offload actor model during V4 gradient calibration",
+                    logger=logger,
+                )
+        return output
+
