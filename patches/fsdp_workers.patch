+    def compute_urcr_v3_focus_targets(self, data: DataProto):
+        """Freeze sparse targets on the same pre-update FSDP actor, on every rank."""
+        from verl.trainer.ppo.urcr_v3_focus import object_array
+        from verl.trainer.ppo.urcr_v3_focus_loss import FocusForward
+
+        assert self._is_actor
+        if self.ulysses_sequence_parallel_size != 1:
+            raise ValueError("V3 focus scorer requires Ulysses=1")
+        version = int(data.meta_info["v3_focus_teacher_version"])
+        if version <= getattr(self, "_v3_last_updated_step", 0):
+            raise RuntimeError("Cannot recompute V3 targets after the outer-step update")
+        cfg = data.meta_info["v3_focus_spec"]
+        micro_size = int(cfg["teacher_micro_batch_size"])
+        if len(data) == 0 or len(data) % micro_size:
+            raise ValueError("V3 teacher requests must be globally padded to world * microbatch")
+        if self._is_offload_param:
+            load_fsdp_model_to_gpu(self.actor_module_fsdp)
+        model = self.actor_module_fsdp
+        was_training = model.training
+        try:
+            if any(p.grad is not None for p in model.parameters()):
+                raise RuntimeError("Actor gradients must be empty before V3 teacher scoring")
+            data = data.to(get_torch_device().current_device())
+            model.eval()
+            get_torch_device().reset_peak_memory_stats()
+            payloads = []
+            max_micro_tokens = 0
+            with torch.no_grad(), self.ulysses_sharding_manager:
+                data = self.ulysses_sharding_manager.preprocess_data(data)
+                for micro in data.chunk(len(data) // micro_size):
+                    tensors = micro.batch
+                    max_micro_tokens = max(max_micro_tokens, int(tensors["attention_mask"].sum()))
+                    context = FocusForward(
+                        responses=tensors["responses"],
+                        response_mask=tensors["attention_mask"][:, -tensors["responses"].shape[-1]:],
+                        payloads=list(micro.non_tensor_batch["v3_focus_payload"]),
+                        topk=int(cfg["topk"]), block_size=int(cfg["logit_chunk_size"]), teacher=True,
+                    )
+                    # Even an all-dummy microbatch executes the same FSDP forward.
+                    self.actor._forward_micro_batch(tensors, temperature=1.0, focus_context=context)
+                    payloads.extend(context.outputs)
+                    del context
+                if any(p.grad is not None for p in model.parameters()):
+                    raise RuntimeError("V3 teacher populated actor gradients")
+                output = DataProto.from_dict(
+                    tensors={
+                        "v3_teacher_no_grad": torch.ones(len(data), dtype=torch.bool),
+                        "v3_teacher_peak_memory_gib": torch.full((len(data),), get_torch_device().max_memory_allocated() / 1024**3),
+                        "v3_teacher_max_micro_tokens": torch.full((len(data),), max_micro_tokens, dtype=torch.long),
+                    },
+                    non_tensors={"v3_focus_payload": object_array(payloads)},
+                )
+                output = self.ulysses_sharding_manager.postprocess_data(output).to("cpu")
+        finally:
