+    def compute_urcr_v4_gradient_stats(self, data: DataProto) -> dict[str, float]:
+        """Measure full-strength global/local parameter gradients without a step."""
+        from verl.trainer.ppo.urcr_v4_local_objective import (
+            local_minibatch_estimator,
+            signed_span_ppo,
+        )
+
+        if self.actor_optimizer is None:
+            raise RuntimeError("V4 gradient calibration requires the trainable actor")
+        if self.config.policy_loss.get("loss_mode", "vanilla") != "vanilla":
+            raise ValueError("V4 gradient calibration requires vanilla PPO")
+        self.actor_module.train()
+        required = (
+            "input_ids",
+            "responses",
+            "attention_mask",
+            "position_ids",
+            "old_log_probs",
+            "advantages",
+            "urcr_v4_span_masks",
+            "urcr_v4_span_coefficients",
+            "urcr_v4_original_row_mask",
+        )
+        missing = [key for key in required if key not in data.batch]
+        if missing:
+            raise ValueError(f"V4 gradient batch is incomplete: {missing}")
+        multi_turn = bool(data.meta_info.get("multi_turn", False))
+        if multi_turn and "loss_mask" not in data.batch:
+            raise ValueError("V4 multi-turn gradient batch requires loss_mask")
+        spec = data.meta_info.get("urcr_v4_local_objective")
+        if not spec:
+            raise ValueError("V4 gradient batch requires local-objective metadata")
+
+        batch = data.select(
+            batch_keys=[*required, *(("loss_mask",) if multi_turn else ())]
+        ).batch
+        if torch.distributed.is_available() and torch.distributed.is_initialized():
+            world_size = torch.distributed.get_world_size()
+        else:
+            world_size = 1
+        micro_batch_size = int(self.config.ppo_micro_batch_size_per_gpu)
+        if micro_batch_size <= 0 or int(batch.batch_size[0]) % micro_batch_size:
+            raise ValueError("V4 gradient rows must divide the actor microbatch")
+        if int(batch.batch_size[0]) != int(self.config.ppo_mini_batch_size):
+            raise ValueError(
+                "V4 gradient calibration requires exactly one normalized actor minibatch"
+            )
+        micro_batches = batch.split(micro_batch_size)
+        gradient_accumulation = int(self.config.ppo_mini_batch_size) // micro_batch_size
+        if gradient_accumulation <= 0:
+            raise ValueError("invalid V4 gradient accumulation")
+        global_original_rows = torch.tensor(
+            int(batch["urcr_v4_original_row_mask"].sum().item()),
+            dtype=torch.long,
+            device=get_torch_device().current_device(),
+        )
+        if world_size > 1:
+            torch.distributed.all_reduce(
+                global_original_rows,
+                op=torch.distributed.ReduceOp.SUM,
+            )
+        if int(global_original_rows) != int(spec["total_sampling_row_count"]):
+            raise ValueError("V4 gradient local population count is inconsistent")
+
+        def backward_objective(name: str) -> None:
+            self.actor_optimizer.zero_grad(set_to_none=True)
+            for micro_batch in micro_batches:
+                values = micro_batch.to(get_torch_device().current_device())
+                responses = values["responses"]
+                response_length = responses.size(1)
+                response_mask = (
+                    values["loss_mask"][:, -response_length:]
+                    if multi_turn
+                    else values["attention_mask"][:, -response_length:]
+                )
+                response_mask = response_mask * values[
+                    "urcr_v4_original_row_mask"
+                ].unsqueeze(-1)
+                if not bool(response_mask.any()):
+                    raise ValueError(
+                        "V4 gradient layout left one actor microbatch empty"
+                    )
+                old_log_prob = values["old_log_probs"]
+                _entropy, log_prob = self._forward_micro_batch(
+                    micro_batch=values,
+                    temperature=float(data.meta_info["temperature"]),
+                    calculate_entropy=False,
+                )
+                if name == "global":
+                    pg_loss = compute_policy_loss(
+                        old_log_prob=old_log_prob,
+                        log_prob=log_prob,
+                        advantages=values["advantages"],
+                        response_mask=response_mask,
+                        cliprange=self.config.clip_ratio,
+                        cliprange_low=(
+                            self.config.clip_ratio_low
+                            if self.config.clip_ratio_low is not None
+                            else self.config.clip_ratio
+                        ),
+                        cliprange_high=(
+                            self.config.clip_ratio_high
+                            if self.config.clip_ratio_high is not None
+                            else self.config.clip_ratio
+                        ),
+                        clip_ratio_c=self.config.get("clip_ratio_c", 3.0),
+                        loss_agg_mode=self.config.loss_agg_mode,
+                    )[0]
+                    loss = (
+                        pg_loss
+                        * float(self.config.get("pg_loss_coef", 1.0))
+                        / gradient_accumulation
+                    )
+                else:
+                    local_terms = signed_span_ppo(
+                        old_log_prob=old_log_prob,
+                        log_prob=log_prob,
+                        span_masks=values["urcr_v4_span_masks"],
+                        coefficients=values["urcr_v4_span_coefficients"],
+                        clip_ratio_low=(
+                            self.config.clip_ratio_low
+                            if self.config.clip_ratio_low is not None
+                            else self.config.clip_ratio
+                        ),
+                        clip_ratio_high=(
+                            self.config.clip_ratio_high
+                            if self.config.clip_ratio_high is not None
+                            else self.config.clip_ratio
+                        ),
+                    )
+                    loss = local_minibatch_estimator(
+                        local_terms.per_row_numerator,
+                        total_sampling_row_count=int(
+                            spec["total_sampling_row_count"]
+                        ),
+                        original_trajectory_count=int(
+                            spec["original_trajectory_count"]
+                        ),
+                        global_minibatch_row_count=int(global_original_rows),
+                        dp_world_size=world_size,
+                    )
+                loss.backward()
+
+        backward_objective("global")
+        global_gradients = []
+        for parameter in self.actor_module.parameters():
+            gradient = parameter.grad
+            global_gradients.append(
+                None
+                if gradient is None
+                else gradient.detach().reshape(-1).float().cpu().clone()
+            )
+
+        backward_objective("local")
+        statistics = torch.zeros(6, dtype=torch.float64, device="cpu")
+        chunk_elements = 4 * 1024 * 1024
+        for parameter, global_gradient in zip(
+            self.actor_module.parameters(), global_gradients
+        ):
+            local_gradient = parameter.grad
+            if global_gradient is None and local_gradient is None:
+                continue
+            if global_gradient is None or local_gradient is None:
+                raise RuntimeError("global/local V4 parameter support differs")
+            local_flat = local_gradient.detach().reshape(-1)
+            if local_flat.numel() != global_gradient.numel():
+                raise RuntimeError("V4 gradient shard changed shape")
+            for start in range(0, local_flat.numel(), chunk_elements):
+                stop = min(start + chunk_elements, local_flat.numel())
+                global_chunk = global_gradient[start:stop]
+                local_chunk = local_flat[start:stop].float().cpu()
+                global_finite = torch.isfinite(global_chunk)
+                local_finite = torch.isfinite(local_chunk)
+                statistics[3] += (~global_finite).sum()
+                statistics[4] += (~local_finite).sum()
+                global_safe = torch.where(
+                    global_finite, global_chunk, torch.zeros_like(global_chunk)
+                ).double()
+                local_safe = torch.where(
+                    local_finite, local_chunk, torch.zeros_like(local_chunk)
+                ).double()
+                statistics[0] += torch.dot(global_safe, global_safe)
+                statistics[1] += torch.dot(local_safe, local_safe)
+                statistics[2] += torch.dot(global_safe, local_safe)
+                statistics[5] += local_chunk.numel()
+        if world_size > 1:
+            statistics = statistics.to(get_torch_device().current_device())
+            torch.distributed.all_reduce(
+                statistics,
+                op=torch.distributed.ReduceOp.SUM,
+            )
+        self.actor_optimizer.zero_grad(set_to_none=True)
+        del global_gradients
+        global_sq, local_sq, dot, global_nonfinite, local_nonfinite, elements = (
+            statistics.cpu().tolist()
+        )
+        global_norm = float(max(global_sq, 0.0) ** 0.5)
+        local_norm = float(max(local_sq, 0.0) ** 0.5)
+        denominator = global_norm * local_norm
+        return {
+            "urcr_v4_gradient/global_l2": global_norm,
+            "urcr_v4_gradient/local_l2": local_norm,
+            "urcr_v4_gradient/local_over_global": (
+                local_norm / global_norm if global_norm > 0 else float("nan")
+            ),
+            "urcr_v4_gradient/global_over_local": (
+                global_norm / local_norm if local_norm > 0 else float("nan")
+            ),
+            "urcr_v4_gradient/cosine": (
+                float(dot / denominator) if denominator > 0 else float("nan")
+            ),
+            "urcr_v4_gradient/global_nonfinite_count": float(global_nonfinite),
+            "urcr_v4_gradient/local_nonfinite_count": float(local_nonfinite),
+            "urcr_v4_gradient/parameter_elements": float(elements),
+            "urcr_v4_gradient/original_row_count": float(global_original_rows),
+            "urcr_v4_gradient/original_trajectory_count": float(
+                spec["original_trajectory_count"]
+            ),
+        }
+
