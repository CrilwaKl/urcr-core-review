+            totals = {key: float(value) for key, value in zip(keys, values.cpu().tolist())}
+            metrics["urcr_actual/denominator_token_sum"] = [totals["denominator_token_sum"]]
+            for role in ("query", "think"):
+                token_count = totals[f"{role}_token_count"]
+                metrics[f"urcr_actual/{role}_token_count"] = [token_count]
+                for suffix in (
+                    "preclip_residual_total",
+                    "postratio_residual_total",
+                    "postclip_surrogate_total",
+                ):
+                    metrics[f"urcr_actual/{role}_{suffix}"] = [totals[f"{role}_{suffix}"]]
+                metrics[f"urcr_actual/{role}_ratio_mean"] = [
+                    totals[f"{role}_ratio_sum"] / max(token_count, 1.0)
+                ]
+                metrics[f"urcr_actual/{role}_clip_fraction"] = [
+                    totals[f"{role}_clipped_token_count"] / max(token_count, 1.0)
+                ]
+                metrics[f"urcr_actual/{role}_reduced_pg_loss_delta"] = [
+                    totals[f"{role}_actual_reduced_pg_loss_delta"] / world_size
+                ]
+        if urcr_same_forward_totals:
+            keys = sorted(urcr_same_forward_totals)
+            values = torch.stack([urcr_same_forward_totals[key] for key in keys])
+            if torch.distributed.is_available() and torch.distributed.is_initialized():
+                torch.distributed.all_reduce(values, op=torch.distributed.ReduceOp.SUM)
+                world_size = torch.distributed.get_world_size()
+            else:
+                world_size = 1
+            for key, value in zip(keys, values.cpu().tolist()):
+                if "/actual_" in key:
+                    value /= world_size
+                metrics[f"urcr_same_forward/{key}"] = [float(value)]
+            metrics["urcr_same_forward/world_size"] = [float(world_size)]
+        if use_focus:
+            if torch.distributed.is_initialized():
+                torch.distributed.all_reduce(focus_totals, op=torch.distributed.ReduceOp.SUM)
+            total = focus_totals.cpu().tolist()
+            raw_mean = total[0] / int(focus_spec["original_trajectories"])
+            metrics.update({
+                "v3_focus/grouped_kl_active_row_mean": [total[0] / max(total[1], 1)],
+                "v3_focus/grouped_kl_rollout_mean": [raw_mean],
+                "v3_focus/scaled_loss": [float(focus_spec["coefficient"]) * raw_mean],
+                "v3_focus/coefficient": [float(focus_spec["coefficient"])],
+                "v3_focus/calibrated_coefficient_max": [float(focus_spec["coefficient_max"])],
+                "v3_focus/consumed_rows": [total[1]],
+                "v3_focus/consumed_tokens": [total[2]],
+                "v3_focus/negative_kl_token_count": [total[5]],
+                "v3_focus/zero_target_rank_fraction": [float(focus_zero_target)],
+                "train/optimizer_steps_this_outer_step": [focus_optimizer_steps],
+            })
+            for i, group in enumerate(("all_success", "all_fail", "mixed")):
+                metrics[f"v3_focus/{group}_kl_active_mean"] = [total[6 + i * 2] / max(total[7 + i * 2], 1)]
+            if focus_spec["measure_energy"]:
+                metrics.update({
+                    "v3_focus/pg_logit_l2": [total[3] ** 0.5],
+                    "v3_focus/unscaled_focus_logit_l2": [total[4] ** 0.5],
+                    "v3_focus/unscaled_focus_over_pg_logit_l2": [(total[4] / total[3]) ** .5 if total[3] > 0 else 0.0],
+                })
         self.actor_optimizer.zero_grad()
         return metrics
